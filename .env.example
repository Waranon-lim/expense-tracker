DATABASE_URL=postgresql://expense_tracker:expense_tracker@localhost:5433/expense_tracker
WEBHOOK_SECRET=dev-local-mock-bank-secret
PORT=3001

# How long a pending expense waits for a user tap before the sweep applies the
# mapping's best guess. Override to a small value (e.g. 5000) for a fast local demo.
CATEGORIZATION_TIMEOUT_MS=30000
CATEGORIZATION_SWEEP_INTERVAL_MS=5000
