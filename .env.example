DATABASE_URL=postgresql://expense_tracker:expense_tracker@localhost:5433/expense_tracker
WEBHOOK_SECRET=dev-local-mock-bank-secret

# Secret used to sign the phone-alert buttons (one token per expense). Any long
# random string. Generate one with: openssl rand -hex 32
NOTIFICATION_SECRET=change-me-to-a-long-random-string

# Sign-up is open when this is true (or not set). Any other value, such as false, closes it once everyone has an account. The very first account can always be created.
ALLOW_SIGNUP=true
PORT=3001

# How long a pending expense waits for a user tap before the sweep applies the
# mapping's best guess. Override to a small value (e.g. 5000) for a fast local demo.
CATEGORIZATION_TIMEOUT_MS=30000
CATEGORIZATION_SWEEP_INTERVAL_MS=5000

# Web Push (VAPID) keys for phone notifications. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
